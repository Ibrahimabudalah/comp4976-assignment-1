@inject TenantAuthorizationService AuthService

<div class="top-row ps-3 navbar navbar-dark bg-primary bg-gradient">
    <div class="container-fluid">
        <a class="navbar-brand fw-bold" href="">
            <span>MEMS Admin</span>
        </a>
    </div>
</div>

<div class="nav-scrollable">
    <nav class="flex-column p-2">
        <div class="nav-item px-2 py-1">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="me-2">📊</span> Dashboard
            </NavLink>
        </div>

        @if (isSuperAdmin)
        {
            <div class="nav-item px-2 py-1">
                <NavLink class="nav-link" href="municipalities">
                    <span class="me-2">🏛️</span> Municipalities
                </NavLink>
            </div>
        }

        <div class="nav-item px-2 py-1">
            <NavLink class="nav-link" href="positions">
                <span class="me-2">💼</span> Positions
            </NavLink>
        </div>

        <div class="nav-item px-2 py-1">
            <NavLink class="nav-link" href="candidates">
                <span class="me-2">👥</span> Candidates
            </NavLink>
        </div>

        @if (isSuperAdmin)
        {
            <div class="nav-item px-2 py-1">
                <NavLink class="nav-link" href="users">
                    <span class="me-2">🛡️</span> Administrators
                </NavLink>
            </div>
        }
    </nav>
</div>

@code {
    private bool isSuperAdmin = false;

    protected override async Task OnInitializedAsync()
    {
        isSuperAdmin = await AuthService.IsSuperAdminAsync();
    }
}
