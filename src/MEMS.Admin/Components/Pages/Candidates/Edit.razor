@page "/candidates/edit/{id:int}"
@attribute [Authorize]
@inject ICandidateRepository CandidateRepo
@inject IPositionRepository PositionRepo
@inject TenantAuthorizationService AuthService
@inject ImageUploadService ImageUploadService
@inject NavigationManager Navigation
@inject ILogger<Edit> Logger

<PageTitle>Edit Candidate - MEMS Admin</PageTitle>

<div class="container-fluid" style="max-width: 800px;">
    <div class="mb-4">
        <a href="candidates" class="btn btn-outline-secondary btn-sm mb-2">&larr; Back to Candidates</a>
        <h2 class="fw-bold mb-1">Edit Candidate Profile</h2>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <strong>Error:</strong> @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }

    @if (isLoading)
    {
        <div class="d-flex justify-content-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
        </div>
    }
    else if (candidate == null)
    {
        <div class="alert alert-warning">Candidate not found or access denied.</div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <EditForm Model="model" OnValidSubmit="HandleSubmit">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="text-danger mb-3" />

                    <div class="row g-3">
                        <div class="col-md-7">
                            <label class="form-label fw-semibold">Candidate Full Name *</label>
                            <InputText @bind-Value="model.Name" class="form-control" />
                            <ValidationMessage For="() => model.Name" class="text-danger small" />
                        </div>

                        <div class="col-md-5">
                            <label class="form-label fw-semibold">Position Contested *</label>
                            <InputSelect @bind-Value="model.PositionId" class="form-select">
                                @foreach (var p in availablePositions)
                                {
                                    <option value="@p.PositionId">@p.Municipality.Name - @p.Name</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="() => model.PositionId" class="text-danger small" />
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold">Candidate Biography / Platform *</label>
                            <InputTextArea @bind-Value="model.Profile" class="form-control" rows="4" />
                            <ValidationMessage For="() => model.Profile" class="text-danger small" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Email Address (Optional)</label>
                            <InputText @bind-Value="model.Email" class="form-control" />
                            <ValidationMessage For="() => model.Email" class="text-danger small" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Campaign Website URL (Optional)</label>
                            <InputText @bind-Value="model.Website" class="form-control" />
                            <ValidationMessage For="() => model.Website" class="text-danger small" />
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold">Current Photograph</label>
                            <div class="d-flex align-items-center gap-3 mb-2">
                                @if (!string.IsNullOrEmpty(candidate.PhotoFileName))
                                {
                                    <img src="uploads/candidates/@candidate.PhotoFileName" alt="@candidate.Name" class="rounded border p-1" style="width: 80px; height: 80px; object-fit: cover;" />
                                }
                                else
                                {
                                    <span class="text-muted small">No photo currently uploaded.</span>
                                }
                            </div>
                            <label class="form-label fw-semibold">Upload New Photograph (Optional)</label>
                            <InputFile OnChange="HandlePhotoSelected" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a href="candidates" class="btn btn-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4" disabled="@isSubmitting">
                            @if (isSubmitting)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                <span>Saving...</span>
                            }
                            else
                            {
                                <span>Save Changes</span>
                            }
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private Candidate? candidate;
    private UpdateCandidateDto model = new();
    private List<Position> availablePositions = new();
    private IBrowserFile? newPhotoFile;
    private string? errorMessage;
    private bool isLoading = true;
    private bool isSubmitting = false;

    protected override async Task OnInitializedAsync()
    {
        candidate = await CandidateRepo.GetByIdAsync(Id);
        if (candidate != null)
        {
            if (!await AuthService.CanManageMunicipalityAsync(candidate.MunicipalityId))
            {
                candidate = null;
            }
            else
            {
                var isSuper = await AuthService.IsSuperAdminAsync();
                availablePositions = isSuper
                    ? await PositionRepo.GetAllAsync()
                    : await PositionRepo.GetAllAsync(candidate.MunicipalityId);

                model = new UpdateCandidateDto
                {
                    CandidateId = candidate.CandidateId,
                    Name = candidate.Name,
                    Profile = candidate.Profile,
                    PhotoFileName = candidate.PhotoFileName,
                    Email = candidate.Email,
                    Website = candidate.Website,
                    PositionId = candidate.PositionId
                };
            }
        }
        isLoading = false;
    }

    private void HandlePhotoSelected(InputFileChangeEventArgs e)
    {
        newPhotoFile = e.File;
    }

    private async Task HandleSubmit()
    {
        if (candidate == null) return;
        isSubmitting = true;
        errorMessage = null;

        try
        {
            var targetPosition = await PositionRepo.GetByIdAsync(model.PositionId);
            if (targetPosition == null)
            {
                errorMessage = "Selected position does not exist.";
                isSubmitting = false;
                return;
            }

            if (!await AuthService.CanManageMunicipalityAsync(targetPosition.MunicipalityId))
            {
                errorMessage = "You do not have permission to assign candidate to this municipality.";
                isSubmitting = false;
                return;
            }

            var oldPhoto = candidate.PhotoFileName;
            if (newPhotoFile != null)
            {
                var newPhotoName = await ImageUploadService.SaveImageAsync(newPhotoFile, "candidates");
                candidate.PhotoFileName = newPhotoName;
                if (!string.IsNullOrEmpty(oldPhoto))
                {
                    ImageUploadService.DeleteImage(oldPhoto, "candidates");
                }
            }

            candidate.Name = model.Name.Trim();
            candidate.Profile = model.Profile.Trim();
            candidate.Email = model.Email?.Trim();
            candidate.Website = model.Website?.Trim();
            candidate.PositionId = model.PositionId;
            candidate.MunicipalityId = targetPosition.MunicipalityId;

            await CandidateRepo.UpdateAsync(candidate);
            Navigation.NavigateTo("candidates");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unexpected error updating candidate {CandidateId}", Id);
            errorMessage = "An unexpected error occurred while updating the candidate. Please try again.";
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
