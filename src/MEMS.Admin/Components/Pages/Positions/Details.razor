@page "/positions/details/{id:int}"
@attribute [Authorize]
@inject IPositionRepository PositionRepo
@inject TenantAuthorizationService AuthService
@inject NavigationManager Navigation

<PageTitle>Position Details - MEMS Admin</PageTitle>

<div class="container-fluid" style="max-width: 800px;">
    <div class="mb-4">
        <a href="positions" class="btn btn-outline-secondary btn-sm mb-2">&larr; Back to Positions</a>
        <h2 class="fw-bold mb-1">Position Details</h2>
    </div>

    @if (isLoading)
    {
        <div class="d-flex justify-content-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
        </div>
    }
    else if (position == null)
    {
        <div class="alert alert-warning">Position not found or access denied.</div>
    }
    else
    {
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h3 class="fw-bold mb-0">@position.Name</h3>
                    <span class="badge bg-secondary fs-6">@position.SeatsAvailable Available Seat(s)</span>
                </div>

                <p class="text-muted mb-4">
                    Municipality: <strong>@position.Municipality.Name</strong> (<code>/@position.Municipality.TenantSlug</code>)
                </p>

                <h5 class="fw-bold mb-3">Registered Candidates (@(position.Candidates?.Count ?? 0))</h5>
                @if (position.Candidates == null || !position.Candidates.Any())
                {
                    <div class="alert alert-light border">No candidates currently registered for this position.</div>
                }
                else
                {
                    <ul class="list-group mb-4">
                        @foreach (var c in position.Candidates)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <strong>@c.Name</strong>
                                    @if (!string.IsNullOrEmpty(c.Email))
                                    {
                                        <small class="text-muted ms-2">&middot; @c.Email</small>
                                    }
                                </div>
                                <a href="candidates/details/@c.CandidateId" class="btn btn-outline-secondary btn-sm">View Profile</a>
                            </li>
                        }
                    </ul>
                }

                <div class="d-flex gap-2">
                    <a href="positions/edit/@position.PositionId" class="btn btn-primary">Edit Position</a>
                    <a href="candidates/create" class="btn btn-outline-info">+ Register Candidate</a>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private Position? position;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        position = await PositionRepo.GetByIdAsync(Id);
        if (position != null && !await AuthService.CanManageMunicipalityAsync(position.MunicipalityId))
        {
            position = null;
        }
        isLoading = false;
    }
}
