@page "/users"
@attribute [Authorize(Roles = AdminRoles.SuperAdmin)]
@inject UserManager<ApplicationUser> UserManager
@inject IMunicipalityRepository MunicipalityRepo
@inject NavigationManager Navigation

<PageTitle>Administrators - MEMS Admin</PageTitle>

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Administrative Accounts</h2>
            <span class="text-muted">Manage Super Admins and Municipality Administrators across tenants.</span>
        </div>
        <a href="users/create" class="btn btn-primary">
            + New Administrator
        </a>
    </div>

    @if (isLoading)
    {
        <div class="d-flex justify-content-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Username</th>
                            <th>Full Name</th>
                            <th>Role / Group</th>
                            <th>Tenant Affiliation</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in users)
                        {
                            <tr>
                                <td>
                                    <strong>@user.UserName</strong>
                                </td>
                                <td>@(user.FullName ?? "-")</td>
                                <td>
                                    @if (userRoles.TryGetValue(user.Id, out var roles))
                                    {
                                        @foreach (var r in roles)
                                        {
                                            <span class="badge @(r == AdminRoles.SuperAdmin ? "bg-danger" : "bg-primary") me-1">
                                                @r
                                            </span>
                                        }
                                    }
                                </td>
                                <td>
                                    @if (user.Municipality != null)
                                    {
                                        <span>@user.Municipality.Name</span>
                                        <span class="badge bg-light text-dark border ms-1 font-monospace">/@user.Municipality.TenantSlug</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">System-Wide (All Tenants)</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a href="users/edit/@user.Id" class="btn btn-outline-primary">Edit</a>
                                        <a href="users/delete/@user.Id" class="btn btn-outline-danger">Delete</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private List<ApplicationUser> users = new();
    private Dictionary<string, IList<string>> userRoles = new();
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        var allUsers = UserManager.Users.ToList();
        var municipalities = await MunicipalityRepo.GetAllAsync();
        var munMap = municipalities.ToDictionary(m => m.MunicipalityId);

        users = allUsers;
        foreach (var u in users)
        {
            if (u.MunicipalityId.HasValue && munMap.TryGetValue(u.MunicipalityId.Value, out var m))
            {
                u.Municipality = m;
            }
            userRoles[u.Id] = await UserManager.GetRolesAsync(u);
        }

        isLoading = false;
    }
}
