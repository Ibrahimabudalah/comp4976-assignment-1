<Router AppAssembly="typeof(Program).Assembly" NotFoundPage="typeof(Pages.NotFound)">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
            <NotAuthorized>
                <div class="container py-5 text-center">
                    <div class="alert alert-warning shadow-sm d-inline-block p-4 text-start">
                        <h4><i class="bi bi-shield-lock"></i> Access Denied</h4>
                        <p class="mb-2">You are not authorized to access this administrative resource.</p>
                        <a href="/login" class="btn btn-primary btn-sm me-2">Log In</a>
                        <a href="/" class="btn btn-outline-secondary btn-sm">Return to Dashboard</a>
                    </div>
                </div>
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>
