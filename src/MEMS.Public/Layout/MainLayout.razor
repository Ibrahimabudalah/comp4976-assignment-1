@inherits LayoutComponentBase
@inject IJSRuntime JS

<nav class="navbar navbar-expand-lg bg-body-tertiary border-bottom no-print">
    <div class="container">
        <a class="navbar-brand fw-bold" href="/">MEMS</a>
        <span class="navbar-text d-none d-sm-inline">Municipal Elections</span>
        <button class="btn btn-outline-secondary ms-auto" type="button" @onclick="ToggleTheme"
                aria-label="Switch between light and dark mode">
            @(isDark ? "☀ Light" : "🌙 Dark")
        </button>
    </div>
</nav>

<main class="container py-4">
    @* Global exception handling: an unexpected error in any page shows a friendly message (the
       exception is logged by Blazor) and the next navigation recovers. *@
    <ErrorBoundary @ref="errorBoundary">
        <ChildContent>@Body</ChildContent>
        <ErrorContent>
            <ErrorAlert Message="Something went wrong on this page. Please go back or try again." />
            <a href="/" class="btn btn-primary">Back to municipalities</a>
        </ErrorContent>
    </ErrorBoundary>
</main>

<footer class="container py-3 text-body-secondary small border-top no-print">
    MEMS · COMP 4976 Assignment 2
</footer>

@code {
    private bool isDark;
    private ErrorBoundary? errorBoundary;

    // The layout gets new parameters on every navigation: clear a previous error so the new page can render.
    protected override void OnParametersSet() => errorBoundary?.Recover();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        isDark = await JS.InvokeAsync<string>("memsTheme.current") == "dark";
        StateHasChanged();
    }

    private async Task ToggleTheme()
        => isDark = await JS.InvokeAsync<string>("memsTheme.toggle") == "dark";
}
