@page "/"
@inject MemsApiClient Api

<PageTitle>MEMS</PageTitle>

<h1>Municipalities</h1>

@if (names == null)
{
    <p>Loading...</p>
}
else
{
    <ul>@foreach (var n in names) { <li>@n</li> }</ul>
}

@code {
    // temporary Phase 1 connectivity check; replaced by the municipality picker in Phase 3
    private List<string>? names;
    protected override async Task OnInitializedAsync()
        => names = (await Api.GetMunicipalitiesAsync()).Select(m => m.Name).ToList();
}
